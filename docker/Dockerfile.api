FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443
# git + docker CLI: needed so this container can trigger the manual
# self-update flow (see SystemController.cs) via the mounted docker.sock.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["src/LaundryPOS.Domain/LaundryPOS.Domain.csproj", "LaundryPOS.Domain/"]
COPY ["src/LaundryPOS.Application/LaundryPOS.Application.csproj", "LaundryPOS.Application/"]
COPY ["src/LaundryPOS.Infrastructure/LaundryPOS.Infrastructure.csproj", "LaundryPOS.Infrastructure/"]
COPY ["src/LaundryPOS.IoT/LaundryPOS.IoT.csproj", "LaundryPOS.IoT/"]
COPY ["src/LaundryPOS.API/LaundryPOS.API.csproj", "LaundryPOS.API/"]
RUN dotnet restore "LaundryPOS.API/LaundryPOS.API.csproj"
COPY src/ .
WORKDIR "/src/LaundryPOS.API"
RUN dotnet build "LaundryPOS.API.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "LaundryPOS.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
COPY VERSION ./VERSION
ENTRYPOINT ["dotnet", "LaundryPOS.API.dll"]
